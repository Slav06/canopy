# Demo uses an isolated local JSON file. Live mode requires PostgreSQL and login.
WORKSPACE_MODE=demo
DATABASE_URL=postgresql://canopy:canopy@localhost:5432/canopy
APP_ORIGIN=http://127.0.0.1:3210
SESSION_SECRET=replace-with-at-least-32-random-characters
DIALERR_PUBLISHABLE_KEY=
# Remain false until account entitlements, embed permissions and an approved test are checked.
LIVE_CALLING_ENABLED=false
DIALERR_ROLE_BOUNDARY_VERIFIED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
# Single-message sending is separately gated; false until owner-approved testing.

# Toolbar-only Dialerr: in-widget login; no secret, API token, or token URL.

# Free automatic nearby street imagery. One workspace read-only client token.
# Register at https://www.mapillary.com/dashboard/developers (no Google billing).
MAPILLARY_CLIENT_TOKEN=

# Street-level imagery is deferred; leave disabled until account setup is completed.
NEXT_PUBLIC_MAPILLARY_ENABLED=false

# Hosted private documents; defaults to local .data when unset.
CRM_DATA_DIR=
# Set only for first live launch; remove the password after Admin creation.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Canopy Admin
BOOTSTRAP_ADMIN_PASSWORD=

# Set false on hosts without persistent private file storage.
PRIVATE_UPLOADS_ENABLED=true
